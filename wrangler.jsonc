{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  "custom_domains": ["hendrive.co.il"],
  "env": {
    "staging": {
      "name": "tanstack-start-app-staging",
      "workers_dev": true
    }
  }
}
